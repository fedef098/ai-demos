# Copy to .env and fill per project. build-modules.sh / publish.sh auto-load it.
#
# ⚠️  .env is SOURCED as shell. Any value containing a SPACE (or shell-special
#     chars like [] * **) MUST be single-quoted, e.g. DEMO_SUBMIT_TEXT='Sign in'.
#     An unquoted space makes bash treat the rest as a command → the variable is
#     silently NOT set and the demo breaks (classic symptom: login never submits
#     and every page bounces back to /login). When in doubt, quote it.

# --- Target (the LIVE, deployed app — never a dev server) ---
DEMO_URL=https://myapp.example.com
DEMO_PASS=changeme

# --- Login flow selectors (override if your app differs; quote if they have spaces) ---
DEMO_LOGIN_PATH=/login
DEMO_USER_SEL='#username'
DEMO_PASS_SEL='#password'
DEMO_SUBMIT_TEXT='Sign in'
DEMO_POST_LOGIN_URL='**/dashboard'

# --- Narration (Kokoro) ---
# House voice is Spanish ef_dora / lang e. For English use an English voice, e.g.
# DEMO_VOICE=af_heart with DEMO_LANG=a (American English).
DEMO_VOICE=ef_dora
DEMO_LANG=e

# --- Recording (fixed for determinism / repeatable output) ---
DEMO_W=1600
DEMO_H=900
DEMO_DSF=1
DEMO_FPS=30
DEMO_CRF=22

# --- Subtitles ---
DEMO_SUBS=1            # emit .srt/.vtt from narration timing
DEMO_BURN_SUBS=1       # 1 = burn subs into the video
DEMO_SUB_FONTSIZE=12   # burned-in font size (small so it doesn't cover the UI)
DEMO_SUB_MAXCHARS=46   # resegment each step into <=N-char one-line phrases (0 = off)

# --- TTS venv (created by ./setup-tts.sh) ---
KOKORO_VENV=./.kokoro-venv

# --- Publish: the project's OWN object storage ---
S3_BUCKET=myapp
S3_PUBLIC_URL=https://myapp-files.example.com/myapp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Upload backend A (RECOMMENDED for in-cluster k8s MinIO — reliable, no port-forward):
# stream straight into the MinIO pod's mc via `kubectl exec`.
#   MINIO_POD='minio-xxxxxxxx-yyyyy'     # kubectl -n <ns> get pods | grep minio
#   MINIO_NS='myapp'
#   KUBECTL='sudo -n kubectl'            # how to invoke kubectl (default: kubectl)
# MINIO_POD=
# MINIO_NS=
# KUBECTL=kubectl

# Upload backend B (fallback / non-k8s): port-forward + docker minio/mc.
# PF_CMD='kubectl -n myapp port-forward svc/minio 9913:9000'
# MINIO_PORT=9913

# --- Determinism / provenance ---
DEMO_SEED=          # stable suffix for created records (blank = timestamp)
# DEMO_DATE / DEMO_COMMIT are auto-derived by publish.sh if unset.
