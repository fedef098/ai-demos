#!/usr/bin/env bash
# Encuentra el motor de demos y le pasa los argumentos.
#
# El motor vive en este repo, bajo `engine/`. Acá también viven los workspaces
# de cada producto, bajo `demos/<producto>/`.
#
#   DEMOS_DIR=demos/wig bin/demo <slug> --check
#   DEMOS_DIR=demos/wig bin/demo <slug>
#   bin/demo --doctor
#
# Para usar un motor en otra ruta, exportá DEMO_RUNNER apuntando a su `runner/`.

set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [ -z "${DEMO_RUNNER:-}" ]; then
  DEMO_RUNNER="$REPO_ROOT/engine/runner"
fi

if [ -z "${DEMO_RUNNER:-}" ] || [ ! -x "$DEMO_RUNNER/demo.sh" ]; then
  printf '\033[31m✖ No encontré el motor de demos en %s.\033[0m\n' "$DEMO_RUNNER" >&2
  printf 'Exportá DEMO_RUNNER apuntando al runner/ del motor.\n' >&2
  exit 1
fi

exec "$DEMO_RUNNER/demo.sh" "$@"
