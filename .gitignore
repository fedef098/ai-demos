# This repo holds the plugin only — recorded demos live in each target project.

**/node_modules/
**/__pycache__/
*.pyc

# If you record from inside this repo while testing: no binaries in git.
# (The rule shipped to target projects is skills/product-demo/templates/demos.gitignore.)
demos/**/*.mp4
demos/**/*.webm
demos/**/*.wav
demos/**/*.jpg
demos/**/*.png
demos/.auth/
demos/.voice-cache/

.DS_Store
