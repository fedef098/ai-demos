# Los NOMBRES de las variables que necesita este workspace. Nunca los valores.
#
# Este archivo NO se sourcea y el motor NO lo lee: existe para documentar. Se
# probó sourcear un .env y salió caro — un valor sin comillas dejaba la
# credencial vacía y el video entero terminaba siendo la pantalla de login
# (skills/product-demo/references/lessons.md). Exportalas a mano.

# El front desplegado que se graba. Nunca producción, nunca un dev server.
DEMO_BASE_URL=https://bb-merge.forwhenigo.com

# La API del MISMO entorno: el seed escribe por HTTP, no contra la base.
# Ojo, el prefijo cambia según el entorno: bb-merge-api.* pero api-qa.*
WIG_DEMO_API_URL=https://bb-merge-api.forwhenigo.com

# La cuenta propia de la demo. El alias +test@ no es cosmético: WIG marca
# isTestAccount con él, y eso es lo que la mantiene afuera de las métricas.
WIG_DEMO_EMAIL=algo+test@gmail.com
WIG_DEMO_PASSWORD=
