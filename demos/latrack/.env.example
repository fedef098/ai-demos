# Latrack demos — names only, never values. The engine does NOT read this file:
# export the variables in your shell (see README.md).
DEMO_BASE_URL=https://qa-latrack.adavance.com
# Password Ramiro (the demo owner) chooses when he accepts the invitation. Any
# random string of 10+ characters; it only has to stay the same for one run.
DEMO_OWNER_PW=
# A public test stream the station form can probe and the web player can play.
DEMO_STREAM_URL=https://ice1.somafm.com/u80s-128-mp3
# Optional: Railway project id of Latrack (defaults to the one in the seed).
LATRACK_RAILWAY_PROJECT=
